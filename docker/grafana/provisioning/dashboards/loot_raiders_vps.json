{
  "title": "Loot Raiders VPS",
  "uid": "loot-raiders-vps",
  "tags": ["loot-raiders"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "CPU Usage %",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)", "legendFormat": "CPU %"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "colorMode": "background"},
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}}
    },
    {
      "id": 2, "type": "stat", "title": "RAM Usage %",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "RAM %"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 75}, {"color": "red", "value": 90}]}}}
    },
    {
      "id": 3, "type": "stat", "title": "Disk Usage %",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"}) * 100)", "legendFormat": "Disk %"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 80}, {"color": "red", "value": 90}]}}}
    },
    {
      "id": 4, "type": "stat", "title": "Network In",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "rate(node_network_receive_bytes_total{device=\"ens3\"}[2m])", "legendFormat": "In"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"},
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    },
    {
      "id": 5, "type": "stat", "title": "Network Out",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "rate(node_network_transmit_bytes_total{device=\"ens3\"}[2m])", "legendFormat": "Out"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"},
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    },
    {
      "id": 6, "type": "stat", "title": "System Uptime",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "node_time_seconds - node_boot_time_seconds", "legendFormat": "Uptime"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"},
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 7, "type": "timeseries", "title": "CPU Usage Over Time",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)", "legendFormat": "CPU %"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"lineWidth": 2, "fillOpacity": 20}, "color": {"mode": "palette-classic"}, "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 90}]}}}
    },
    {
      "id": 8, "type": "timeseries", "title": "Memory Usage Over Time",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / 1024 / 1024", "legendFormat": "Used RAM (MB)"},
        {"expr": "node_memory_MemTotal_bytes / 1024 / 1024", "legendFormat": "Total RAM (MB)"}
      ],
      "fieldConfig": {"defaults": {"unit": "mbytes", "custom": {"lineWidth": 2, "fillOpacity": 10}}}
    },
    {
      "id": 9, "type": "timeseries", "title": "Network Traffic",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 7},
      "targets": [
        {"expr": "rate(node_network_receive_bytes_total{device=\"ens3\"}[2m])", "legendFormat": "In (Bps)"},
        {"expr": "rate(node_network_transmit_bytes_total{device=\"ens3\"}[2m])", "legendFormat": "Out (Bps)"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"lineWidth": 2}}}
    },
    {
      "id": 10, "type": "timeseries", "title": "Disk I/O",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 7},
      "targets": [
        {"expr": "rate(node_disk_read_bytes_total[2m])", "legendFormat": "Read (Bps)"},
        {"expr": "rate(node_disk_written_bytes_total[2m])", "legendFormat": "Write (Bps)"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"lineWidth": 2}}}
    }
  ]
}
